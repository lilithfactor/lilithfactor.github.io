---
/**
 * The mark for one Connect link.
 *
 * WHERE THE PATHS COME FROM, because "an icon" is a licensing question wearing
 * a design question's clothes.
 *
 * Brand marks come from `simple-icons`, which is CC0 and ships the official
 * glyph each company publishes. That matters more than it sounds: a brand logo
 * redrawn by a third party is somebody's interpretation of a trademark, and it
 * carries that person's licence terms on top of the trademark's. Simple Icons
 * carries neither. It is also a build-time dependency — the path string is
 * inlined into the prerendered HTML and the package ships nothing to a
 * visitor.
 *
 * Two are drawn here by hand, and for two different reasons:
 *
 *   LinkedIn — Simple Icons removed it after LinkedIn asked them to, so there
 *   is no CC0 source for it. This is a plain "in" built from a circle, a bar
 *   and a stem: recognisable, not traced from LinkedIn's file. If the exact
 *   official mark is wanted, drop LinkedIn's own SVG in and use it here.
 *
 *   Email — not a brand at all. An envelope, drawn as line work so it sits in
 *   the same ink as the rest of the page rather than as a solid blob.
 *
 * Everything is `currentColor` and 1em, so an icon is the weight of the text
 * beside it and inherits every state the link already has. aria-hidden and
 * focusable="false": the link's own words are the accessible name, and an icon
 * that announces itself would say "LinkedIn LinkedIn".
 */
import { siChessdotcom, siGithub, siGoodreads, siInstagram, siSpotify } from "simple-icons";

interface Props {
  label: string;
}

const { label } = Astro.props;

const BRANDS: Record<string, { path: string }> = {
  github: siGithub,
  instagram: siInstagram,
  spotify: siSpotify,
  goodreads: siGoodreads,
  "chess.com": siChessdotcom,
};

const brand = BRANDS[label.toLowerCase()];
const key = label.toLowerCase();
---

{
  brand && (
    <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d={brand.path} fill="currentColor" />
    </svg>
  )
}

{
  key === "linkedin" && (
    <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="4.6" cy="4.6" r="2.3" fill="currentColor" />
      <rect x="2.7" y="8.4" width="3.8" height="12.6" rx="0.4" fill="currentColor" />
      <path
        d="M9.3 8.4h3.6v1.9c.62-1.1 1.9-2.1 3.9-2.1 3 0 4.7 1.9 4.7 5.4V21h-3.8v-6.8c0-1.85-.7-2.85-2.2-2.85-1.3 0-2.05.86-2.4 1.7-.13.3-.16.72-.16 1.15V21H9.3V8.4z"
        fill="currentColor"
      />
    </svg>
  )
}

{
  key === "email" && (
    <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect
        x="2.6"
        y="5.4"
        width="18.8"
        height="13.2"
        rx="1.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
      />
      <path
        d="M3.6 7.4 12 13.4l8.4-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
