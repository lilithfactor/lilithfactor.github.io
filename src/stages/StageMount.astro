---
/**
 * StageMount — the one place the 3D desk can enter the page.
 *
 * It renders nothing. Its entire job is to run the capability gate and, only
 * if the gate passes, to dynamically import the desk. That ordering is the
 * point of the component: a phone must not download Three.js, and "must not"
 * is a claim about the network tab, not about an `if` statement that runs
 * after the bytes have already arrived.
 *
 * A static `import` of ./desk/scene here would put Three.js in the page's
 * initial bundle on every device and then decline to run it, which is the
 * regression this file exists to make impossible. The import below is
 * dynamic, so Rollup emits it as its own chunk that nothing in the initial
 * document references. Verified in brain/work/steps.md; the check is a build
 * assertion, because this is exactly the kind of thing that silently regresses.
 *
 * The canvas is created by the scene rather than rendered here, so a device
 * that does not get the desk gets no element for it either.
 *
 * architecture.md Directives 3 and 4 · ux-rules.md rule 12.
 */
import "../styles/stage.css";
// The live-desk presentation: turns the document's sections into panels that
// desk objects open. Scoped entirely to html[data-stage="desk"], so it cannot
// reach the no-JS document or the mobile stack.
import "../styles/desk-panels.css";
---

<script>
  // Static, and deliberately tiny: this is the only stage code that ships in
  // the initial page bundle. It imports nothing from three.
  import { canMountDesk } from "./choose";

  // Astro emits this as a deferred module script, so it runs after the
  // document is parsed and the content is already readable. Nothing below can
  // block first paint. ux-rules.md rule 12, load order steps 3 and 4.
  if (canMountDesk()) {
    // Idle-deferred: the desk is an enhancement, and building a WebGL scene
    // during the load window blocks the first interaction for no reader value.
    // The timeout guarantees it still arrives on busy pages.
    const whenIdle =
      "requestIdleCallback" in window
        ? (fn: () => void) => requestIdleCallback(fn, { timeout: 2000 })
        : (fn: () => void) => setTimeout(fn, 350);
    whenIdle(() => {
    void Promise.all([import("./desk/scene"), import("./panels")])
      .then(async ([scene, panelsModule]) => {
        // ORDER MATTERS. mountDesk() binds anchors once, by querying the DOM
        // for [data-anchor] nodes; handles created after it are never bound and
        // sit unpositioned at opacity 0. So panels mount FIRST — their handles
        // must already exist when the desk looks for them.
        const panels = panelsModule.mountPanels();
        // Async now: the desk loads its models before it builds, because the
        // objects determine the anchor positions the panels' handles track.
        const desk = await scene.mountDesk();
        // ...but if the desk never arrives, the panels have to undo themselves:
        // they mark sections aria-hidden, which would silently hide the whole
        // portfolio from assistive tech on a page with no desk to open them.
        if (!desk) panels.dispose();
      })
      .catch(() => {
        // No desk. From the visitor's point of view nothing failed: they are
        // looking at the complete, prerendered portfolio either way, and an
        // error message would be the only thing here that could break it.
      });
    });
  } else if (matchMedia("(max-width: 1023px)").matches) {
    // Beat 8: the pocket edition gets one dismissible chip — never a wall
    // (ux-rules.md rule 8). Small-viewport only: a desktop that failed the
    // gate for another reason (WebGL, reduced motion) is already on the right
    // stage and the chip would just be noise.
    const KEY = "desk-chip-dismissed";
    if (!localStorage.getItem(KEY)) {
      const chip = document.createElement("p");
      chip.className = "stack-chip";
      chip.innerHTML = `<span>Best on desktop — there's a whole desk over there</span>`;
      const x = document.createElement("button");
      x.type = "button";
      x.setAttribute("aria-label", "Dismiss");
      x.textContent = "✕";
      x.addEventListener("click", () => {
        localStorage.setItem(KEY, "1");
        chip.remove();
      });
      chip.append(x);
      document.body.append(chip);
    }
  }
</script>
