---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Chips from "../../components/Chips.astro";
import { caseStudies } from "../../content/index";

export function getStaticPaths() {
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs },
  }));
}

const { cs } = Astro.props;

/* Outcome before method (ux-rules.md rule 11): a hiring manager skimming for
 * twenty seconds must hit the numbers. The Results bullets are written as
 * "Metric: value", so they split cleanly into a metric grid at the top —
 * presented, not parsed: no regex guessing at which token is the number. */
const results = cs.body.find((s) => s.heading !== null && /result/i.test(s.heading));
const outcomes = (
  results?.blocks.flatMap((b) => (b.type === "list" ? b.items : [])) ?? []
)
  .map((line) => {
    const i = line.indexOf(":");
    return i > 0 && i < 40
      ? { term: line.slice(0, i).trim(), value: line.slice(i + 1).trim() }
      : { term: null, value: line };
  })
  .slice(0, 4);

/* The narrative keeps every section in STAR order — including Results, in
 * full, in place. The grid above is the skim path, not a replacement. */
const body = cs.body;

/* Case-study screenshots were the heaviest thing on the site: six untouched
 * PNGs, 4.4 MB, on the one page a hiring manager actually opens.
 *
 * Astro only optimises images it can resolve at build time, and nothing here
 * is resolvable: the sync downloads into public/ and writes the finished URL
 * string into content/case-studies.json. A glob over that directory is the one
 * bridge that needs no change to the sync — Vite resolves every file, Astro's
 * pipeline hands back ImageMetadata, and the keys map straight onto the
 * /case-studies/<slug>/<n>.<ext> strings the JSON already carries.
 *
 * What it costs, plainly: public/ is still public/, so the build copies each
 * original into dist untouched beside its optimised derivative. Nothing
 * requests them any more — it is weight in the deploy, not on the wire.
 * Removing it means the sync writing into src/, which is a sync change.
 *
 * .svg stays out of the glob on purpose: Astro turns an imported SVG into a
 * component rather than an image. Any image the glob misses — an extension
 * nobody has synced yet, or a file the sync recorded but failed to write —
 * falls through to the plain <img> below and renders exactly as it did. */
const sources = import.meta.glob<{ default: ImageMetadata }>(
  "../../../public/case-studies/*/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);
const optimised = new Map(
  Object.entries(sources).map(([file, mod]) => [
    file.slice(file.indexOf("/case-studies/")),
    mod.default,
  ]),
);

/* .page is 60rem wide with 1.5rem of gutter, so a figure is never painted
 * wider than 912px. Anything above the source's own width would be an upscale
 * paid for in bytes. */
const COLUMN_PX = 912;
const SIZES = `(min-width: 60rem) ${COLUMN_PX}px, calc(100vw - 3rem)`;

/* Structured data. These eight pages are the site's indexable surface — eight
 * long-form authored documents — and nothing in the markup said so. The Article
 * node says what they are; `author` points at the Person node Schema.astro
 * always emits, which is what attaches the work to the name.
 *
 * No datePublished/dateModified: the CaseStudy schema carries no date field and
 * an invented one is worse than an absent one. Both are recommended, not
 * required. See the note at the foot of src/components/Schema.astro. */
const site = Astro.site!.href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const article = {
  "@type": "Article",
  "@id": `${url}#article`,
  headline: cs.name, // longest is 53 chars, well under Google's 110 cap
  description: cs.summary,
  url,
  mainEntityOfPage: url,
  inLanguage: "en",
  author: { "@id": `${site}#pranav` },
  isPartOf: { "@id": `${site}#website` },
  keywords: [...cs.type, ...cs.domain, ...cs.kpis],
};

/* Two rungs, not three: there is no /case-studies/ index page, and a ListItem
 * pointing at a URL that does not exist is a Search Console error rather than a
 * rich result. The last rung correctly carries no `item` — it is this page. */
const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Pranav Upadhyay", item: site },
    { "@type": "ListItem", position: 2, name: cs.name },
  ],
};
---

<Base
  title={`${cs.name} — Pranav Upadhyay`}
  description={cs.summary}
  ogType="article"
  schema={[article, breadcrumbs]}
>
  <main id="main-content" tabindex="-1" class="page stack">
    <a class="back-link" href="/#case-studies">← Back to desk</a>

    <header class="stack">
      <p class="label">Case study</p>
      <h1 class="display">{cs.name}</h1>
    </header>

    <p class="lead">{cs.summary}</p>
    <Chips items={cs.kpis} />

    {
      outcomes.length > 0 && (
        <section class="sheet outcome-grid" aria-label="Outcomes">
          {outcomes.map((o) => (
            <div class="outcome">
              {o.term && <p class="label">{o.term}</p>}
              <p class="outcome__value">{o.value}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      body.length > 0 && (
        <article class="stack case-body">
          {body.map((section) => (
            <section class="stack">
              {section.heading && <h2>{section.heading}</h2>}
              {section.blocks.map((block) => {
                if (block.type === "list")
                  return (
                    <ul class="case-body__list">
                      {block.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  );
                if (block.type === "quote")
                  return <blockquote class="note">{block.text}</blockquote>;
                if (block.type === "callout")
                  return <p class="sheet sheet--aged case-body__callout">{block.text}</p>;
                if (block.type === "para") return <p>{block.text}</p>;
                if (block.type === "link")
                  return (
                    <p>
                      <a href={block.url} target="_blank" rel="noopener">
                        {new URL(block.url).hostname.replace(/^www\./, "")}
                      </a>
                    </p>
                  );
                if (block.type === "image") {
                  const img = optimised.get(block.src);
                  /* block.width, not img.width. ImageMetadata is a Proxy, and
                     any property read outside Astro's own pipeline marks the
                     source as referenced — which keeps the untouched original
                     in dist beside the derivatives, 11 MB nothing requests.
                     The sync already measured the file; use its number. */
                  const widths = [...new Set([480, COLUMN_PX, block.width])].filter(
                    (w) => w <= block.width,
                  );
                  /* Empty alt on purpose, in both branches. A captioned figure
                     is already named by its caption, and repeating the
                     sentence makes a screen reader read it twice; an
                     uncaptioned one has no description in Notion, and "name —
                     supporting figure" described nothing. The real fix is an
                     alt property on the Notion image, carried through the sync
                     and the schema. */
                  return (
                    <figure class="case-body__figure">
                      {img ? (
                        <Image
                          src={img}
                          alt=""
                          widths={widths}
                          sizes={SIZES}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <img
                          src={block.src}
                          alt=""
                          width={block.width}
                          height={block.height}
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      {block.caption && (
                        <figcaption class="note">{block.caption}</figcaption>
                      )}
                    </figure>
                  );
                }
                return null;
              })}
            </section>
          ))}
        </article>
      )
    }

    {
      body.length === 0 && (
        <p class="note">
          The full write-up for this one is being typed up — the summary above is the
          shape of it.
        </p>
      )
    }

    {
      cs.links.length > 0 && (
        <div>
          <p class="label">Links</p>
          <p class="link-row">
            {cs.links.map((url) => (
              <a href={url} target="_blank" rel="noopener">
                {new URL(url).hostname.replace(/^www\./, "")}
              </a>
            ))}
          </p>
        </div>
      )
    }

    <hr class="rule" />
    <a class="back-link" href="/#case-studies">← Back to desk</a>
  </main>
</Base>
