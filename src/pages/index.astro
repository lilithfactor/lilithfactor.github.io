---
import Base from "../layouts/Base.astro";
import LinkIcon from "../components/LinkIcon.astro";
import Section from "../components/Section.astro";
import Chips from "../components/Chips.astro";
import Mascot from "../components/Mascot.astro";
import LogEntry, { subjectSlug } from "../components/LogEntry.astro";
// The desk mounts here and only here: it is this page's presentation of the
// sections below. In the layout it leaked onto every page — a case-study
// article with a 3D scene painting behind its text (Base.astro has the note).
import StageMount from "../stages/StageMount.astro";
import {
  about,
  caseStudies,
  divesMade,
  divesStudied,
  projects,
  recommendations,
  library,
  beyond,
  links,
  playlist,
  type CaseStudy,
  type ProductDive,
} from "../content/index";

const byNewest = (a: { date: string | null }, b: { date: string | null }) =>
  (b.date ?? "").localeCompare(a.date ?? "");

const madeSorted = [...divesMade].sort(byNewest);
const studiedSorted = [...divesStudied].sort(byNewest);

// The meta line: what a recruiter wants before the prose — when, who for, what
// kind. UTC so the build machine's timezone can't push a 1st back a month.
const monthYear = new Intl.DateTimeFormat("en-GB", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const diveMeta = (d: ProductDive) =>
  [
    d.date && monthYear.format(new Date(d.date)),
    ...d.gtm,
    ...d.productType,
    // Pricing is a Notion *url* property. A 130-character link would overflow
    // the line, so only the plain answers ("Free") make it in.
    d.pricing && !d.pricing.startsWith("http") ? d.pricing : null,
  ]
    .filter(Boolean)
    .join(" · ");

const caseMeta = (cs: CaseStudy) =>
  [cs.role, ...cs.domain, ...cs.type].filter(Boolean).join(" · ");

// Notion labels a bare URL "Visit", which put two identical chips on Muretabi.
// The host says which store it is.
const linkLabel = ({ url, label }: { url: string; label: string }) => {
  if (label !== "Visit") return label;
  if (url.includes("apps.apple.com")) return "App Store";
  if (url.includes("play.google.com")) return "Play Store";
  return label;
};

/* --- The Library, read as a log ---------------------------------------------
 *
 * The year field records when Pranav READ a book, not when it was published, so
 * it only ever holds 2025 or 2026. A tabular year column of two repeating values
 * is dead weight; the year becomes the group head and the MONTH becomes the
 * right-flush column. That inversion is what turns a list into a log, and it
 * comes out of the data rather than out of a layout preference. */
const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sept",
  "Oct",
  "Nov",
  "Dec",
];
const mIdx = (m: string | null) => (m ? MONTHS.indexOf(m) : -1);

const reading = library.filter((b) => b.status === "reading");

/* Newest first. A book with a year but no month sorts to the foot of its year,
 * which is where a gap belongs in a log. */
const finished = library
  .filter((b) => b.status === "done")
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || mIdx(b.month) - mIdx(a.month));

/* Nothing queued carries a date, so chronology is meaningless here and
 * alphabetical makes the dense two-column block read as an actual index. */
const queued = library
  .filter((b) => b.status === "enqueued" || b.status === "tbd")
  .sort((a, b) => a.name.localeCompare(b.name));

const years = [...new Set(finished.map((b) => b.year))]
  .filter((y): y is number => y !== null)
  .sort((a, b) => b - a)
  .map((year) => ({ year, books: finished.filter((b) => b.year === year) }));

/* The subject rail, counted from the data. Every book carries a `domain` array
 * that this page used to parse and throw away; this is the whole of its use.
 * Sorted by count, so the shape of the reading is legible before anything is
 * clicked and the single Finance book is honest rather than hidden. */
const counts = library
  .flatMap((b) => b.domain)
  .reduce((m, d) => m.set(d, (m.get(d) ?? 0) + 1), new Map<string, number>());
const subjects = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

/* One rule per subject, emitted at BUILD time from the same array that renders
 * the rail — so a new Notion domain appears in the rail, in the counts and in
 * the lens with nobody editing CSS. It sets a single custom property, --mark,
 * which the entry and the reading slip both spend on the same margin rule and
 * the tag on its own colour and underline: one generated line, two materials.
 * `is:inline` and not `is:global`: is:global marks an Astro-PROCESSED stylesheet
 * and does not compose with raw-string injection. */
const lensCss = subjects
  .map(([name]) => {
    const s = subjectSlug(name);
    return `.log:has(#lens-${s}:checked) :is([data-domain~="${s}"],[data-tag="${s}"]){--mark:var(--accent)}`;
  })
  .join("\n");

const since = (b: { month: string | null; year: number | null }) =>
  [b.month, b.year].filter(Boolean).join(" ");

/* Beyond the routine carries no URL of its own — the Notion database has no
 * such property — so the three pastimes with a public profile borrow the one
 * already in Connect, matched by the link's own label rather than by a URL
 * written out here. Nothing is hardcoded but the pairing.
 * If the beyond database ever gains a URL property, this mapping belongs in Notion. */
const BEYOND_LINK: Record<string, string> = {
  music: "spotify",
  chess: "chess.com",
  reading: "goodreads",
};
const linkByLabel = new Map(links.map((l) => [l.label.toLowerCase(), l]));
const beyondLink = (name: string) => {
  const label = BEYOND_LINK[name.toLowerCase()];
  return label ? linkByLabel.get(label) : undefined;
};
---

<Base
  title="Pranav Upadhyay — Product Manager"
  description="Product Manager who turns messy, high-stakes journeys into simple, confident experiences."
>
  <main id="main-content" tabindex="-1" class="page stack">
    {
      /* .masthead: on the desk stage this lifts out of the document flow and
        sits on the desk itself, so a visitor knows whose desk they landed on
        before they click anything. In the document page it is just a header. */
    }
    <header class="masthead">
      {
        /* A head beside the name, watching the cursor: whose desk this is,
          answered before the text is read. brain/design/art-direction.md,
          "The head by the name". TO CHANGE THE CHARACTER: point the two paths
          below at another pair of sheets in public/mascots (knight-* is there
          too; any of the fifty-two at koboyo.com/page-mascot drops in), or draw
          the likeness — brain/vision/todo.md has the command. */
      }
      <Mascot
        directions="/mascots/beard-directions.webp"
        reactions="/mascots/beard-reactions.webp"
        label="Pranav"
      />
      <div class="stack">
        <p class="label">Product Manager</p>
        <h1 class="display">Pranav Upadhyay</h1>
      </div>
    </header>

    <Section id="about" label="About" title="About">
      <p class="lead">{about.headline}</p>
      {about.paragraphs.map((para) => <p>{para}</p>)}
    </Section>

    <Section id="case-studies" label="Case studies" title="Case studies">
      {
        caseStudies.map((cs) => (
          <a
            class="sheet sheet--interactive sheet--lift card-link"
            href={`/case-studies/${cs.slug}/`}
          >
            <p class="label">{caseMeta(cs)}</p>
            <h3>{cs.name}</h3>
            <p>{cs.summary}</p>
            <Chips items={cs.kpis} />
            <span class="label card-cta">Read case study →</span>
          </a>
        ))
      }
    </Section>

    <Section id="product-dives" label="Product dives" title="Product dives">
      <div class="stack">
        <div>
          <p class="label">Things I made</p>
          <div class="card-grid">
            {
              madeSorted.map((d) =>
                d.url ? (
                  <a
                    class="sheet sheet--card sheet--interactive sheet--lift card-link"
                    href={d.url}
                    target="_blank"
                    rel="noopener"
                  >
                    <p class="label">{diveMeta(d)}</p>
                    <h3>{d.name}</h3>
                    <p>{d.summary}</p>
                    <span class="label card-cta">Open ↗</span>
                  </a>
                ) : (
                  <article class="sheet sheet--card">
                    <p class="label">{diveMeta(d)}</p>
                    <h3>{d.name}</h3>
                    <p>{d.summary}</p>
                  </article>
                ),
              )
            }
          </div>
        </div>
        <div>
          <p class="label">Things I studied</p>
          <div class="card-grid">
            {
              studiedSorted.map((d) =>
                d.url ? (
                  <a
                    class="sheet sheet--card sheet--interactive sheet--lift card-link"
                    href={d.url}
                    target="_blank"
                    rel="noopener"
                  >
                    <p class="label">{diveMeta(d)}</p>
                    <h3>{d.name}</h3>
                    <p>{d.summary}</p>
                    <span class="label card-cta">Open ↗</span>
                  </a>
                ) : (
                  <article class="sheet sheet--card">
                    <p class="label">{diveMeta(d)}</p>
                    <h3>{d.name}</h3>
                    <p>{d.summary}</p>
                  </article>
                ),
              )
            }
          </div>
        </div>
      </div>
    </Section>

    <Section id="projects" label="Projects" title="Projects">
      <div class="card-grid">
        {
          projects.map((p) => (
            <article class="sheet">
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
              <Chips items={p.kpis} />
              <p class="link-row">
                {p.links.map((link) => (
                  <a
                    class="chip-link"
                    href={link.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={
                      linkLabel(link) === "Visit" ? `Visit ${p.name}` : undefined
                    }
                  >
                    {linkLabel(link)}
                  </a>
                ))}
              </p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="recommendations" label="Recommendations" title="Recommendations">
      <div class="card-grid">
        {
          recommendations.map((r) => (
            <figure class="sheet sheet--aged">
              <blockquote>{r.quote}</blockquote>
              <figcaption class="note">
                {r.name} · {r.role}
                {r.org ? ` · ${r.org}` : ""}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </Section>

    <Section id="library" label="Library" title="Library">
      {
        /* Not a `.stack`: the log sets its own vertical rhythm, and the stack's
          blanket margin between children fought the rail's sticky offset. */
      }
      {
        /* Two boxes on purpose. The outer one is the container and the :has()
          scope for the lens; the inner one is the grid, because an @container
          rule styles a container's DESCENDANTS and never the container itself. */
      }
      <div class="log">
        <div class="log__grid">
          {
            reading.length > 0 && (
              <section class="reading">
                <h3 class="tier__head">Reading now</h3>
                {/* NOT a shelf — a shelf is where a book is when nobody is
                  reading it. These are the cards left in the pocket when the
                  book came off it: title, author, subjects, and the month it
                  went out. Exactly the fields Notion holds, which is why
                  nothing here is a cover, a page count or a progress bar.
                  Nearly every class is one this page already uses; what is
                  new is in sections.css. .sheet--card is carried for the
                  rotation, which paper.css permits only at card width. */}
                <ul class="reading__slips">
                  {reading.map((b, i) => (
                    <li
                      class:list={[
                        "sheet sheet--card",
                        i % 2 ? "sheet--askew-alt" : "sheet--askew",
                      ]}
                      data-domain={
                        b.domain.length ? b.domain.map(subjectSlug).join(" ") : undefined
                      }
                    >
                      <p class="entry__line">
                        <span class="reading__title">{b.name}</span>
                        {b.author && <span class="entry__author">{b.author}</span>}
                      </p>
                      {b.domain.length > 0 && (
                        <p class="entry__tags">
                          {b.domain.map((d) => (
                            <span class="tag" data-tag={subjectSlug(d)}>
                              {d}
                            </span>
                          ))}
                        </p>
                      )}
                      {since(b) && <p class="reading__since">Since {since(b)}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <p class="label log__colophon">
            {library.length} titles · {reading.length} reading · {finished.length} finished
            ·{" "}
            {queued.length} next up · {subjects.length} subjects
          </p>

          {
            /* A native radiogroup: one tab stop for all eleven subjects, arrow keys
            and Home/End for free, the count inside the label so a screen reader
            announces it. No script anywhere in this section. */
          }
          <fieldset class="rail">
            <legend class="label rail__legend">By subject</legend>
            <p class="rail__hint">
              Pick one to mark its titles in the margin; nothing is hidden.
            </p>
            <div class="rail__items">
              <input class="vh" type="radio" name="lens" id="lens-all" checked />
              <label class="rail__item" for="lens-all">
                <span class="rail__name">Whole shelf</span>
                <span class="vh">, </span>
                <span class="rail__n">{library.length}</span>
              </label>
              {
                subjects.map(([name, n]) => (
                  <Fragment>
                    <input
                      class="vh"
                      type="radio"
                      name="lens"
                      id={`lens-${subjectSlug(name)}`}
                    />
                    <label class="rail__item" for={`lens-${subjectSlug(name)}`}>
                      <span class="rail__name">{name}</span>
                      <span class="vh">, </span>
                      <span class="rail__n">{n}</span>
                    </label>
                  </Fragment>
                ))
              }
            </div>
          </fieldset>

          <div class="log__body">
            <section class="tier">
              <h3 class="tier__head">Finished</h3>
              {
                years.map(({ year, books }) => (
                  <Fragment>
                    <h4 class="year">
                      {/* The hidden comma is load-bearing: without it this
                          heading's accessible name is the two numbers run
                          together — "20266". Same in every rail row. */}
                      <span class="year__n">{year}</span>
                      <span class="vh">, </span>
                      <span class="year__count">
                        {books.length}
                        <span class="vh"> books</span>
                      </span>
                    </h4>
                    <ul class="entries">
                      {books.map((b) => (
                        <LogEntry book={b} when={b.month} />
                      ))}
                    </ul>
                  </Fragment>
                ))
              }
            </section>

            <section class="tier">
              <h3 class="tier__head">Next up</h3>
              <ul class="entries entries--dense">
                {queued.map((b) => <LogEntry book={b} tags={false} />)}
              </ul>
            </section>
          </div>
        </div>
      </div>
      <style is:inline set:html={lensCss}></style>
    </Section>

    <Section id="beyond" label="Beyond the routine" title="Beyond the routine">
      <div class="card-grid">
        {
          beyond.map((i) => {
            const link = beyondLink(i.name);
            return (
              <article class="sheet sheet--card">
                <h3>{i.name}</h3>
                <p class="note">{i.desc}</p>
                {link && (
                  <p class="link-row">
                    <a class="chip-link" href={link.url} target="_blank" rel="noopener">
                      <LinkIcon label={link.label} />
                      {link.label}
                    </a>
                  </p>
                )}
              </article>
            );
          })
        }
      </div>
    </Section>

    <Section id="connect" label="Connect" title="Connect">
      <nav class="link-row link-row--large" aria-label="Connect">
        {
          links.map((l) => (
            <a
              href={l.url}
              target={l.url.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener"
            >
              <LinkIcon label={l.label} />
              {l.label}
            </a>
          ))
        }
      </nav>
    </Section>
    <script
      type="application/json"
      id="playlist"
      set:html={JSON.stringify(playlist)}
      is:inline
    />
  </main>
  <StageMount />
</Base>

<style>
  /* Head and name sit on one baseline, the head a touch clear of the text. */
  .masthead {
    display: flex;
    align-items: flex-end;
    gap: var(--s-4);
  }
</style>
