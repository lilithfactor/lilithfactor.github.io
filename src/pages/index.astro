---
import Base from "../layouts/Base.astro";

// Phase 0 specimen. This page exists to prove the material before any content
// is wired up — if the paper is wrong here, it is wrong everywhere.
// Real content arrives in Phase 1 from content/*.json. See brain/vision/todo.md.

const kpis = ["Conversion", "Engagement", "Revenue", "Time-to-market"];
---

<Base
  title="Pranav Upadhyay — Product Manager"
  description="Product Manager who turns messy, high-stakes journeys into simple, confident experiences."
>
  <main class="page stack">
    <p class="label">Phase 0 · paper specimen</p>

    {/* No &nbsp; between the names — an unbreakable pair set the page's minimum
        width and overflowed a 390px phone. Let it wrap. */}
    <h1 class="display">Pranav Upadhyay</h1>

    <p style="max-width: var(--measure); font-size: var(--t-subhead-size);">
      I'm a Product Manager who turns messy, high-stakes journeys into simple,
      confident experiences.
    </p>

    <hr class="rule" />

    <!-- A sheet at rest -->
    <article class="sheet">
      <p class="label">Case study</p>
      <h2 style="margin-top: var(--s-2);">Visual Compare for Mass-Market Buyers</h2>
      <p style="margin-top: var(--s-3);">
        Led the end-to-end design and launch of a visual Compare module within 45
        days, defining research, PRD, flows, and analytics while coordinating
        design, 3D, engineering, DevOps, and client teams.
      </p>
      <p style="margin-bottom: 0;">
        {kpis.map((k) => <span class="chip" style="margin-right: 0.35rem;">{k}</span>)}
      </p>
    </article>

    <!-- Interactive: lifts on hover and on keyboard focus -->
    <article class="sheet sheet--interactive sheet--lift" tabindex="0">
      <p class="label">Outcome</p>
      <p class="metric" style="margin: var(--s-2) 0;">60% faster</p>
      <p style="margin-bottom: 0;">
        Onboarding, with bounce halved — via funnel diagnostics, 3D visual cues and
        in-AR onboarding.
      </p>
    </article>

    <!-- Askew + aged + curled: the "used desk" treatment.
         Only ever on --card. The rotation is illegible at full width. -->
    <article class="sheet sheet--card sheet--aged sheet--askew sheet--curled">
      <p class="label">Margin note</p>
      <p class="note" style="margin-bottom: 0;">
        Perfect alignment reads as a template. A 2–4° rotation does more for
        believability than any shader — and the only curve paper gets is a curled
        corner, which is a mask, not a radius.
      </p>
    </article>

    <hr class="rule" />

    <section>
      <p class="label">Type specimen</p>
      <p style="font-family: var(--font-display); font-size: var(--t-title-size); margin-top: var(--s-3);">
        Fraunces — display, opsz 9–144
      </p>
      <p style="margin-bottom: var(--s-2);">
        Source Serif 4 — body at 17px, the size a case study is actually read at.
        Héctor García, Nassim Taleb, Franz Kafka. <a href="#top">A link looks like this.</a>
      </p>
      <p class="label">IBM Plex Mono — labels · tags · metrics · 0123456789</p>
    </section>

    <hr class="rule" />

    <footer>
      <p class="note" style="margin-bottom: 0;">
        Warm off-white, never #fff · contact shadows that touch · corners ≤ 2px ·
        grain at 3.5%. If these four are right, everything built on top reads as
        paper.
      </p>
    </footer>
  </main>
</Base>
